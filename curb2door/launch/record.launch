<?xml version="1.0"?>
<launch>
    <arg name="bag_path" default="$(find curb2door)/bag_raw"/>
    <arg name="record" default="True"/>
    <arg name="rviz"  default="False"/>

    <node if="$(arg record)" name="rosbag" pkg="rosbag" type="record" args="-o $(arg bag_path) /livox/lidar /livox/imu /insta_image_yuv" output="screen"/>

    <param name="xfer_format" value="1"/>
	<param name="multi_topic" value="0"/>
	<param name="data_src" value="0"/>
	<param name="publish_freq" type="double" value="10.0"/>
	<param name="output_data_type" value="0"/>
	<param name="cmdline_str" type="string" value="100000000000000"/>
	<param name="cmdline_file_path" type="string" value="livox_test.lvx"/>
	<param name="user_config_path" type="string" value="$(find curb2door)/config/MID360_config.json"/>
	<param name="frame_id" type="string" value="livox_frame"/>
	<param name="enable_lidar_bag" type="bool" value="true"/>
	<param name="enable_imu_bag" type="bool" value="true"/>

	<node name="livox_lidar_publisher2" pkg="livox_ros_driver2"
	      type="livox_ros_driver2_node" required="true"
	      output="screen" args="$(arg cmdline_arg)"/>

    <include file="$(find insta360_ros_driver)/launch/live_process.launch">
        <arg name="debug" value="false"/>
    </include>

    <node if="$(arg debug)" name="rviz" pkg="rviz" type="rviz" args="-d $(find curb2door)/config/rviz/preview.rviz"/>
</launch>